          "when": "nothing in the local registry fits; search the open ecosystem with `npx skills find`"
        },
        {
          "skill": "ecc:skill-scout",
          "when": "searching ECC-style skill sources"
        },
        {
          "skill": "ecc:skill-stocktake",
          "when": "auditing installed skills"
        },
        {
          "skill": "mattpocock-skills:ask-matt",
          "when": "choosing among Matt Pocock skills"
