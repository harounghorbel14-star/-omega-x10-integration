{
  "version": 1,
  "description": "Curated routing for OMEGA-ENGINEERING X10. Each route names a primary specialist, ordered alternatives that stay available, the runtime each one needs, and the fallback when it is missing. Skills not named in any route are still routable through `omega.py route` keyword search over registry/skills.json (every loaded skill is indexed).",
  "precedence": [
    "1. An explicit user request for a specific skill or plugin always wins.",
    "2. Project-local instructions (CLAUDE.md, AGENTS.md, repo conventions) override every routed skill.",
    "3. Within a route, prefer the primary unless its dependency is missing or the task matches an alternative's narrower trigger (e.g. a language-specific ECC testing skill for that language).",
    "4. Never run two workflows that own the same phase at once (e.g. superpowers:test-driven-development and ecc:tdd-workflow). Pick one and say which.",
    "5. Security guidance is additive: vibesec and ECC security skills may both apply; the stricter requirement wins. Never weaken a security requirement to make a test pass.",
    "6. Verification is mandatory before claiming completion: superpowers:verification-before-completion (or ecc:verification-loop) applies to every implementation route.",
    "7. If a dependency is absent, report the diagnostic from `omega.py doctor` and use the listed fallback; do not claim the skill ran."
  ],
  "routes": [
    {
      "id": "requirements-discovery",
      "triggers": [
        "unclear requirements",
        "ambiguous plan",
        "stress-test my plan",
        "grill me",
        "what should we build",
        "design before coding",
        "interview me"
      ],
      "primary": "mattpocock-skills:grill-me",
      "alternatives": [
        {
          "skill": "mattpocock-skills:grill-with-docs",
          "when": "the repo has domain docs / glossary to check answers against"
        },
        {
          "skill": "superpowers:brainstorming",
          "when": "turning an idea into an approved design before any code (superpowers flow)"
        },
        {
          "skill": "mattpocock-skills:grilling",
          "when": "the lower-level one-question-at-a-time grilling loop itself"
        },
        {
          "skill": "mattpocock-skills:to-questionnaire",
          "when": "questions must go to someone else asynchronously"
        },
        {
          "skill": "mattpocock-skills:wait-what",
          "when": "the user is confused by something just said"
        },
        {
          "skill": "mattpocock-skills-extras:loop-me",
          "when": "grilling about workflow specs (beta)"
        },
        {
          "skill": "ecc:council",
          "when": "a go/no-go or tradeoff decision with several valid paths"
        }
      ],
      "skip_when": "Requirements, constraints and success criteria are already explicit. Do not ask questions the codebase can answer.",
      "requires": [],
      "fallback": "Ask one targeted question at a time about the highest-risk unknown."
    },
    {
